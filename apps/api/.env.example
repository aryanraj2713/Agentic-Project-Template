# Backend environment variables (apps/api)
# Copy this file to `.env` and replace the placeholder values below.
# This file is committed and must contain placeholder values only — never real secrets.

# PostgreSQL connection string consumed by app/config.py (Settings.database_url)
# and the Alembic migration environment. The `postgresql+psycopg` scheme selects
# the psycopg (psycopg3) driver.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/appdb
