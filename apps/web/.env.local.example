# ---------------------------------------------------------------------------
# Frontend_App environment variables (apps/web)
#
# Copy this file to `.env.local` and adjust the values for your environment.
# Commit only this `.env.local.example` template; never commit `.env.local`.
# All values below are placeholders only — they contain no real secrets.
# ---------------------------------------------------------------------------

# Server-only base URL of the Backend_App. It is never exposed to browser code.
API_URL=http://localhost:8000

# Name of the HttpOnly cookie owned by the Next.js server action.
AUTH_COOKIE_NAME=session
